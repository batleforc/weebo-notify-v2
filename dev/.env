# Shared development credentials — DELIBERATELY COMMITTED (design §12.1).
#
# This environment is disposable and holds no production value; dev/ is allowlisted
# in .gitleaks.toml for exactly this reason. Keeping the values fixed and in the
# repository is what makes "clone, `task dev:up`, log in as alice" work with no
# setup step at all.
#
# The one exception is dev/.env.local (gitignored), where `task dev:env` generates
# the Authentik admin bootstrap credentials.

# --- Postgres ---
POSTGRES_USER=weebo
POSTGRES_PASSWORD=weebo
POSTGRES_DB=weebo_notify

# --- RustFS (S3) ---
RUSTFS_ACCESS_KEY=weebo-dev
RUSTFS_SECRET_KEY=weebo-dev-secret
RUSTFS_BUCKET=weebo-notify-attachments

# --- Test identities, identical in the mock and in the Authentik blueprint (§12.5) ---
# alice -> group infra-admins ; bob -> group dev-team
DEV_USER_PASSWORD=weebo-dev
