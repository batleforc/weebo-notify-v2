{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/out",
      "!**/dist",
      "!**/build",
      "!**/.source",
      // Generated by `task recu` from the utoipa annotations. Biome and serde_json
      // disagree on how to wrap short arrays, so letting both format it would make
      // the `contract` job fail on a file nobody edited.
      "!content/docs/api/openapi.json",
      // Written by pnpm. Biome formats YAML since 2.6, and reformatting a lockfile
      // pnpm rewrites on every install would only make the check flap.
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  // Biome formats Markdown since 2.6. The prose here (ADRs, advisories, upstream
  // notes copied verbatim) is wrapped by hand; opt in deliberately, not via a bump.
  "markdown": {
    "formatter": {
      "enabled": false
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
