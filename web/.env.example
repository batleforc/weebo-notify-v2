# Copy to .env.local (gitignored) and adjust. The values below are the ones the
# local development stack serves (design §12.1) — `task dev:run` and
# `task dev:oidc` need no change to work with them.
#
# There is no secret in this file, by construction: the OIDC client is public and
# uses Authorization Code + PKCE (§5.1).

VITE_API_BASE_URL=http://localhost:8080
VITE_OIDC_ISSUER=http://localhost:9110
VITE_OIDC_CLIENT_ID=weebo-notify
