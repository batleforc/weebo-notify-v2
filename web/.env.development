# Loaded by Vite in development mode, and committed on purpose: these are the
# endpoints the local stack serves (design §12.1), not credentials. `task dev:up`
# + `task dev:oidc` + `task dev:run` + `task dev:web` therefore works with zero
# setup, which is the whole point of the development environment.
#
# Override any of them in web/.env.local (gitignored) — that is the file to use
# when pointing the frontend at Authentik (`task dev:auth`) or at the public route
# of an Eclipse Che workspace, where the browser cannot reach the pod's localhost.

VITE_API_BASE_URL=http://localhost:8080
VITE_OIDC_ISSUER=http://localhost:9110
VITE_OIDC_CLIENT_ID=weebo-notify

# Where presigned attachment URLs point (§6.1) — `[storage] endpoint` in
# config/dev.toml. The bundle needs it to name that origin in `img-src`: a
# presigned URL is not on the API's origin, so without this a built bundle loads,
# works, and shows no notification image (D26, `src/lib/csp.ts`).
VITE_ATTACHMENT_ORIGIN=http://localhost:9000
