{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/coverage",
      // Cargo's output for the Tauri shell. `useIgnoreFile` above does not cover
      // it: Biome runs from `web/`, so it reads this directory's ignore rules and
      // not the repository root's, where `target/` is listed. Before this line, a
      // desktop or Android build left `tauri-codegen-assets/` here and every
      // subsequent `task lint` waded through it — eight `internalError/io`
      // diagnostics inviting a bug report, from files nobody wrote.
      "!src-tauri/target",
      // Generated by `cargo tauri android init`/`tauri-build`. `gen/android` is
      // committed (see the repository `.gitignore`) but it is a Gradle project, not
      // this project's source, and `gen/schemas` is tauri-build's output.
      "!src-tauri/gen",
      // Regenerated by `task recu` from the committed OpenAPI document. Biome and
      // HeyApi disagree on line wrapping, so letting both format it would make the
      // `contract` job fail on a file nobody edited.
      "!src/api/generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "css": {
    "parser": {
      // `@custom-variant`, `@theme`, `@apply`: Tailwind v4 puts its configuration
      // in the stylesheet (ADR-0004), so the parser has to know the syntax.
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      // Biome lints the `<script>` block of a single-file component and does not
      // read the `<template>`. Anything used only in the markup — which is most of
      // what a component declares — therefore reads as unused. Leaving these on
      // would train everyone to ignore the linter, so they are off HERE and
      // nowhere else: the same rules stay armed across every `.ts` file, which is
      // where they catch real dead code.
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          },
          "style": {
            // shadcn components are `Button`, `Card`, `Input` upstream and are
            // vendored under those names (ADR-0004). Renaming them to satisfy a
            // naming rule would break every copy-paste from the upstream docs.
            "useVueMultiWordComponentNames": "off"
          }
        }
      }
    },
    {
      "includes": ["src/styles/theme.css"],
      "linter": {
        "rules": {
          "complexity": {
            // `prefers-reduced-motion` has to win over whatever a component
            // declared inline; that is the documented way to write the override.
            "noImportantStyles": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
