// Rendered once at container boot by `docker-entrypoint.d/05-runtime-config.sh`
// (design §11, ADR-0021) — the deployed shape of `web/public/env.js`. Nothing
// downstream reads this file directly; it only ever exists as the source
// `envsubst` renders into `/usr/share/nginx/html/env.js`.
window.__ENV__ = {
  apiBaseUrl: "${WNK_API_BASE_URL}",
  oidcIssuer: "${WNK_OIDC_ISSUER}",
  oidcClientId: "${WNK_OIDC_CLIENT_ID}",
};
