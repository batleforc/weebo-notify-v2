{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the front end is allowed to ask the shell for. Tauri v2 denies everything not listed here — plugins and, since build.rs declares them in the app manifest, our own commands too.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "deep-link:default",
    "allow-loopback-authorize",
    "allow-open-external",
    "allow-credential-save",
    "allow-credential-load",
    "allow-credential-clear",
    "allow-credential-session",
    "allow-instance-probe",
    "allow-instance-save",
    "allow-instance-current",
    "allow-instance-clear"
  ]
}
