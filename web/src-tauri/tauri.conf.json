{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "weebo-notify",
  "identifier": "poc.weebo.notify",
  "version": "0.1.3",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "manifest-src": "'self'",
        "worker-src": "'self'",
        "form-action": "'self'",
        "base-uri": "'none'",
        "frame-src": "'none'",
        "object-src": "'none'"
      },
      "devCsp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["weebo-notify"]
      },
      "mobile": [{ "scheme": ["weebo-notify"] }]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/icon.png", "icons/icon@1024.png"],
    "category": "Utility",
    "shortDescription": "Rich, multi-channel notifications",
    "longDescription": "Infrastructure notifications in real time, from the same inbox the web and the CLI read."
  }
}
