# The deployable web bundle (design §10, ADR-0021, §14.4/D17).
#
# A separate image from the server's, because they are separate origins: the CSP
# this image serves names the API's origin explicitly (`web/src/lib/csp.ts`).
# Serving both from one process would make the policy's `connect-src` describe
# something that is not true.
#
# One image now serves every deployment (ADR-0021, superseding ADR-0019's
# build-time form): the API origin, the issuer and the client id are runtime
# environment on the container, not a build argument, and so is what the
# Content-Security-Policy names — see `nginx/docker-entrypoint.d/`.
#
# NOT VERIFIED HERE — same as the server's Containerfile: no container engine in
# this workspace (§12.4), so the first build happens on the Forgejo runner.

# ─────────────────────────────────────────────────────────────────────────────
# Build
# ─────────────────────────────────────────────────────────────────────────────
# `$BUILDPLATFORM`: the bundle is platform-independent, so the arm64 image reuses a
# native build instead of running pnpm and Vite under QEMU.
FROM --platform=$BUILDPLATFORM docker.io/library/node:26-slim@sha256:0d1e33586362bb9e608c4e751e7a9e7edb55c9ac11461ed5666af696cc461dd4 AS builder

WORKDIR /build

# Corepack is no longer shipped with Node, so pnpm is installed by hand. The version
# is pinned to the one this repository develops on: pnpm 12 writes lockfile 9, and a
# major that reads it differently would resolve a tree nobody tested.
# npm 11 skips global install scripts unless allowed; pnpm's own is the only one
# approved, by name, so a dependency it pulled in could not run one too.
RUN npm install -g --allow-scripts=pnpm pnpm@12.14.0

# Manifests first so the install layer survives a source-only change.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# The `npm ci` equivalent: it fails rather than quietly resolving something the
# committed lockfile does not describe. `pnpm-workspace.yaml` carries the approved
# build-script allowlist (ADR-0011), so that supply-chain guard travels too.
RUN pnpm install --frozen-lockfile

COPY . .

# `vite build` checks the inline-script hash against the page actually written and
# emits `csp-template.txt` next to this Containerfile from it (`vite.config.ts`),
# so this step is the gate as much as it is the artefact — the runtime stage below
# carries that file, not a policy this stage assembled itself.
RUN pnpm build

# ─────────────────────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────────────────────
# `nginx-unprivileged` rather than `nginx`: the stock image starts as root to bind
# :80 and drops afterwards, which needs a root user to exist. This one never has
# one, and listens on :8080 accordingly.
FROM docker.io/nginxinc/nginx-unprivileged:1.31-alpine@sha256:b5047b9b76845eac124358373c6852377c52e4b05834a47647e955dd91cb8f1e AS runtime

# shortcut: CVE-2026-111497 is fixed in Alpine's brotli-libs 1.2.1-r0 but not yet in
# the digest above; drop this once a rebuilt nginx-unprivileged ships it. `USER 101`
# at the end of this stage drops root again.
USER root
RUN apk upgrade --no-cache brotli-libs

# The entrypoint envsubst's `/etc/nginx/templates/*.template` into `conf.d/`. The
# filter is not decoration: without it envsubst rewrites every `$name` in the file,
# and an nginx configuration is full of `$uri`, `$request_uri` and friends — they
# would be replaced with the empty string and the failure would look like a routing
# bug rather than a templating one.
ENV NGINX_ENVSUBST_FILTER="WNK_"

# Where CSP violations are posted. The default is the `return 204` location in the
# template, on this same origin — an endpoint that exists and counts, rather than a
# `report-to` naming nothing.
ENV WNK_CSP_REPORT_URL="/csp-report"

COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=builder /build/dist /usr/share/nginx/html
# The one file under the web root this container writes at boot: everything else
# stays root-owned and read-only to uid 101. Re-copied over itself rather than
# `chown`ed, because the base image already runs as 101 and there is no root here
# to chown with.
COPY --from=builder --chown=101:101 /build/dist/env.js /usr/share/nginx/html/env.js

# The two templates `docker-entrypoint.d/05-runtime-config.envsh` renders — kept
# outside `/usr/share/nginx/html` deliberately, unlike `default.conf.template`
# above, so neither the CSP shape nor the env.js template itself is ever a
# fetchable asset (ADR-0021). `csp-template.txt` is the one build artefact this
# stage carries: `web/vite.config.ts` wrote it from the page actually shipped.
COPY --from=builder /build/csp-template.txt /etc/nginx/wnk-templates/csp-template.txt
COPY nginx/env.js.template /etc/nginx/wnk-templates/env.js.template

# Sourced, not executed: `docker-entrypoint.sh` `.`-sources `*.envsh` (and runs
# `*.sh` in a subshell, whose exports would die with it) — but only when the file
# is executable, and ignores it with a log line otherwise. `--chmod` asserts the
# bit rather than trusting the build context to carry it.
COPY --chmod=755 nginx/docker-entrypoint.d/05-runtime-config.envsh /docker-entrypoint.d/05-runtime-config.envsh

EXPOSE 8080

# The base image already runs as 101, so this changes nothing at runtime — and it
# is not redundant. `trivy config` reads this file and not the base it inherits
# from, so without the line `task audit` fails on DS-0002 (HIGH). More usefully, it
# means a base image that one day starts as root cannot silently promote this one.
USER 101

# `/healthz` and not `/`, for the reason the template gives: `/` serves the SPA
# shell for every path, so it would report healthy on a bundle missing every asset
# it references. wget is in the alpine base; the distroless server image has no
# shell to run an equivalent, which is why only this one carries the instruction.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1:8080/healthz || exit 1

LABEL org.opencontainers.image.title="weebo-notify-web"
LABEL org.opencontainers.image.description="Self-hosted notification hub — web bundle"
LABEL org.opencontainers.image.source="https://github.com/batleforc/weebo-notify-v2"
LABEL org.opencontainers.image.licenses="Apache-2.0"
