# The deployable web bundle (design §10, ADR-0019, §14.4/D17).
#
# A separate image from the server's, because they are separate origins: the bundle
# is built against `VITE_API_BASE_URL` and the CSP names that origin explicitly
# (`web/src/lib/csp.ts`). Serving both from one process would make the policy's
# `connect-src` describe something that is not true.
#
# NOT VERIFIED HERE — same as the server's Containerfile: no container engine in
# this workspace (§12.4), so the first build happens on the Forgejo runner.

# ─────────────────────────────────────────────────────────────────────────────
# Build
# ─────────────────────────────────────────────────────────────────────────────
FROM docker.io/library/node:24-slim AS builder

# The three variables are BUILD arguments and not runtime environment, and that is
# the whole of ADR-0019: a deployment is a build. The API origin, the issuer and the
# client id are inlined into the bundle, and so is the Content-Security-Policy that
# names the first two. There is deliberately no default — `task build:web` refuses
# for the same reason, because a bundle built against the wrong origin loads and
# then cannot reach its own API, which is worse than not building at all.
ARG VITE_API_BASE_URL
ARG VITE_OIDC_ISSUER
ARG VITE_OIDC_CLIENT_ID

RUN test -n "$VITE_API_BASE_URL"  || (echo "VITE_API_BASE_URL is required (ADR-0019)"  >&2; exit 1) && \
    test -n "$VITE_OIDC_ISSUER"   || (echo "VITE_OIDC_ISSUER is required (ADR-0019)"   >&2; exit 1) && \
    test -n "$VITE_OIDC_CLIENT_ID" || (echo "VITE_OIDC_CLIENT_ID is required (ADR-0019)" >&2; exit 1)

WORKDIR /build

# Corepack is no longer shipped with Node, so pnpm is installed by hand. The version
# is pinned to the one this repository develops on: pnpm 11 writes lockfile 9, and a
# major that reads it differently would resolve a tree nobody tested.
RUN npm install -g pnpm@11.18.0

# Manifests first so the install layer survives a source-only change.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
# The `npm ci` equivalent: it fails rather than quietly resolving something the
# committed lockfile does not describe. `pnpm-workspace.yaml` carries the approved
# build-script allowlist (ADR-0011), so that supply-chain guard travels too.
RUN pnpm install --frozen-lockfile

COPY . .

# `vite build` is what stamps the policy and then checks its hashes against the page
# actually written (`vite.config.ts`), so this step is the gate as much as it is the
# artefact.
RUN pnpm build

# ─────────────────────────────────────────────────────────────────────────────
# Runtime
# ─────────────────────────────────────────────────────────────────────────────
# `nginx-unprivileged` rather than `nginx`: the stock image starts as root to bind
# :80 and drops afterwards, which needs a root user to exist. This one never has
# one, and listens on :8080 accordingly.
FROM docker.io/nginxinc/nginx-unprivileged:1.29-alpine AS runtime

# The entrypoint envsubst's `/etc/nginx/templates/*.template` into `conf.d/`. The
# filter is not decoration: without it envsubst rewrites every `$name` in the file,
# and an nginx configuration is full of `$uri`, `$request_uri` and friends — they
# would be replaced with the empty string and the failure would look like a routing
# bug rather than a templating one.
ENV NGINX_ENVSUBST_FILTER="WNK_"

# Where CSP violations are posted. The default is the `return 204` location in the
# template, on this same origin — an endpoint that exists and counts, rather than a
# `report-to` naming nothing.
ENV WNK_CSP_REPORT_URL="/csp-report"

COPY nginx/default.conf.template /etc/nginx/templates/default.conf.template
COPY --from=builder /build/dist /usr/share/nginx/html

EXPOSE 8080

# The base image already runs as 101, so this changes nothing at runtime — and it
# is not redundant. `trivy config` reads this file and not the base it inherits
# from, so without the line `task audit` fails on DS-0002 (HIGH). More usefully, it
# means a base image that one day starts as root cannot silently promote this one.
USER 101

# `/healthz` and not `/`, for the reason the template gives: `/` serves the SPA
# shell for every path, so it would report healthy on a bundle missing every asset
# it references. wget is in the alpine base; the distroless server image has no
# shell to run an equivalent, which is why only this one carries the instruction.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://127.0.0.1:8080/healthz || exit 1

LABEL org.opencontainers.image.title="weebo-notify-web"
LABEL org.opencontainers.image.description="Self-hosted notification hub — web bundle"
LABEL org.opencontainers.image.source="https://github.com/batleforc/weebo-notify-v2"
LABEL org.opencontainers.image.licenses="MIT"
